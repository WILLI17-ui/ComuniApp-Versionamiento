# Cadena de conexión de Supabase (Project Settings > Database > Connection string > URI, modo "Transaction pooler")
DATABASE_URL=postgresql://postgres.xxxxx:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Texto largo y aleatorio para firmar los tokens
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# URL(s) del frontend separadas por coma
FRONTEND_URL=http://localhost:5173
PORT=4000
