# Copia este archivo como .env.local y completa con los datos de tu proyecto de Supabase
# (Supabase > Project Settings > API Keys). Sin estas variables la app funciona en "modo demostración".
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable
